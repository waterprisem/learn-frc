---
// The four robot modes along a timeline and which Robot.java methods run in each.
const modes = [
  { name: 'Disabled', enabled: false, x: 8, w: 150, once: 'disabledInit()', loop: 'disabledPeriodic()' },
  { name: 'Autonomous', enabled: true, x: 166, w: 150, once: 'autonomousInit()', loop: 'autonomousPeriodic()' },
  { name: 'Teleoperated', enabled: true, x: 324, w: 150, once: 'teleopInit()', loop: 'teleopPeriodic()' },
  { name: 'Test', enabled: true, x: 482, w: 150, once: 'testInit()', loop: 'testPeriodic()' },
];
---
<figure class="lf-diagram not-content">
  <svg viewBox="0 0 640 236" role="img" aria-labelledby="mt-title mt-desc">
    <title id="mt-title">Robot modes and methods</title>
    <desc id="mt-desc">Four modes in order: disabled, autonomous, teleoperated and test. Disabled does not drive motors; the other three are enabled. Each mode runs its Init method once and its Periodic method every 20 milliseconds. robotPeriodic runs in every mode.</desc>
    <defs>
      <marker id="mt-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="context-stroke" />
      </marker>
    </defs>

    {modes.map((m) => (
      <g>
        <rect class="node" x={m.x} y="34" width={m.w} height="40" rx="6" style={m.enabled ? 'stroke: var(--sig-output); stroke-width: 2.5' : 'stroke-dasharray: 5 4'} />
        <text x={m.x + m.w / 2} y="59" text-anchor="middle">{m.name}</text>
        <text x={m.x + m.w / 2} y="22" text-anchor="middle" class="muted">{m.enabled ? 'enabled' : 'motors blocked'}</text>
        <rect class="node" x={m.x} y="92" width={m.w} height="34" rx="6" />
        <text x={m.x + m.w / 2} y="107" text-anchor="middle" class="muted">once</text>
        <text x={m.x + m.w / 2} y="120" text-anchor="middle" font-size="11.5">{m.once}</text>
        <rect class="node" x={m.x} y="132" width={m.w} height="34" rx="6" />
        <text x={m.x + m.w / 2} y="147" text-anchor="middle" class="muted">every ~20 ms</text>
        <text x={m.x + m.w / 2} y="160" text-anchor="middle" font-size="11.5">{m.loop}</text>
      </g>
    ))}

    <rect class="node" x="8" y="180" width="624" height="34" rx="6" style="stroke: var(--sig-measurement); stroke-width: 2" />
    <text x="320" y="202" text-anchor="middle">robotPeriodic() runs every ~20 ms in every mode</text>
    <path class="wire" d="M158 54H164M316 54H322" marker-end="url(#mt-arrow)" />
  </svg>
  <figcaption>The Driver Station picks the mode. Disabled still runs code; only motor output is blocked.</figcaption>
</figure>

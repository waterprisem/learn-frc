---
// Real lab code from src/snippets/ as a click-through walkthrough: each note opens under its line.
import { codeToTokens } from 'shiki';
import CodeWalkthrough from './CodeWalkthrough.tsx';

interface Props {
  /** Snippet id from src/snippets/manifest.json, e.g. "lab4/closed-loop-calculate". */
  file: string;
  title?: string;
  /** `lines` is a line or range within the snippet ("2" or "2-3"). `text` may contain <code> and <strong>. */
  notes?: Array<{ lines: string; text: string }>;
}
const { file, title, notes = [] } = Astro.props;
const all = import.meta.glob<string>('../../snippets/**/*.java', { query: '?raw', import: 'default', eager: true });
const code = all[`../../snippets/${file}.java`];
if (code === undefined) throw new Error(`Unknown snippet "${file}". Add it to src/snippets/manifest.json and run npm run snippets.`);

const { tokens } = await codeToTokens(code.trimEnd(), { lang: 'java', themes: { light: 'github-light', dark: 'github-dark' } });
const lines = tokens.map((line) => line.map((t) => ({ text: t.content, style: (t.htmlStyle ?? {}) as Record<string, string> })));
const parsed = notes.map((n) => {
  const [start, end = start] = n.lines.split('-').map(Number);
  if (!start || end > lines.length) throw new Error(`Note lines "${n.lines}" are outside snippet "${file}" (${lines.length} lines).`);
  return { start, end, html: n.text };
});
---
<CodeWalkthrough client:visible title={title} lines={lines} notes={parsed} />

---
// The whole learning path as a grid of tracks. Data: src/data/path.mjs.
import { tracks } from '../data/path.mjs';
---

<div class="path-map not-content">
  {
    tracks.map((t) => (
      <section class="track">
        <h3>
          {t.key} · {t.label}
        </h3>
        <p>{t.blurb}</p>
        <ol>
          {t.lessons.map(([id, slug, title, , isNew]) => (
            <li>
              <span class="num">{id}</span>
              <a href={`/${t.dir}/${slug}/`}>{title}</a>
              {isNew && <span class="badge-new">extra</span>}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

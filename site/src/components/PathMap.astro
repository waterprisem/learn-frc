---
// Home page learning path. Data: src/data/path.mjs plus each lesson's status from its frontmatter.
import { getCollection } from 'astro:content';
import { tracks } from '../data/path.mjs';
import { url } from '../lib/url';
import HomePath from './home/HomePath.tsx';

const docs = await getCollection('docs');
const ready = new Set(docs.filter((d) => d.data.status === 'review' || d.data.status === 'done').map((d) => d.data.id));

const groups = [
  { title: 'Get ready', blurb: 'Programming basics, the robot itself, and the tools you will use.', keys: ['0', '1', 'R'] },
  { title: 'Core skills', blurb: 'Everything up to the Week 6 checkpoint: mechanisms, control, and robot actions.', keys: ['2', '3', '4', '5'] },
  { title: 'Advanced', blurb: 'Driving, vision, autonomous, and life after training.', keys: ['6', '7', '8', '9'] },
];
const stages = groups.map((g) => ({
  title: g.title,
  blurb: g.blurb,
  tracks: g.keys.flatMap((k) => tracks.filter((t) => t.key === k)).map((t) => ({
    key: t.key,
    label: t.label,
    blurb: t.blurb,
    lessons: t.lessons.map(([id, slug, title, , isNew]) => ({ id, title, href: url(`/${t.dir}/${slug}/`), ready: ready.has(id), isNew })),
  })),
}));
---
<HomePath client:load stages={stages} />

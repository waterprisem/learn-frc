---
// The whole learning path as a grid of tracks. Data: src/data/path.mjs.
import { Activity, Blocks, BookOpen, Camera, Cpu, Gauge, Navigation, Rocket, Route, Terminal, Wrench } from 'lucide-react';
import { tracks } from '../data/path.mjs';

const icons: Record<string, typeof Cpu> = {
  '0': BookOpen, '1': Cpu, R: Wrench, '2': Terminal, '3': Activity, '4': Gauge,
  '5': Blocks, '6': Navigation, '7': Camera, '8': Route, '9': Rocket,
};
---

<div class="path-map not-content">
  {
    tracks.map((t) => {
      const Icon = icons[t.key] ?? BookOpen;
      return (
        <section class="track">
          <h3>
            <span class="track-icon"><Icon size={18} aria-hidden="true" /></span>
            <span><small>Track {t.key}</small>{t.label}</span>
          </h3>
          <p>{t.blurb}</p>
          <ol>
            {t.lessons.map(([id, slug, title, , isNew]) => (
              <li>
                <span class="num">{id}</span>
                <a href={`/${t.dir}/${slug}/`}>{title}</a>
                {isNew && <span class="badge-new">extra</span>}
              </li>
            ))}
          </ol>
        </section>
      );
    })
  }
</div>

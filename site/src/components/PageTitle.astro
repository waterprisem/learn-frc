---
// Overrides Starlight's PageTitle to add the lesson header (track, time, session, outcomes, prerequisites).
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { CalendarDays, Clock, Layers, Milestone } from 'lucide-react';
import { lessons } from '../data/path.mjs';
import { url } from '../lib/url';

const data = Astro.locals.starlightRoute.entry.data;
const lesson = data.id && data.status !== 'stub' ? lessons.find((l) => l.id === data.id) : undefined;
const prereqs = (data.prereqs ?? []).flatMap((id: string) => lessons.find((l) => l.id === id) ?? []);
---
<Default />
{lesson && (
  <div class="lf-meta not-content" data-lesson-id={lesson.id}>
    <span><Layers size={15} aria-hidden="true" />{lesson.trackLabel} · Lesson {lesson.id}</span>
    {data.minutes && <span><Clock size={15} aria-hidden="true" />About {data.minutes} min</span>}
    {data.session && <span><CalendarDays size={15} aria-hidden="true" />Curriculum session {data.session}</span>}
    {prereqs.length > 0 && (
      <span><Milestone size={15} aria-hidden="true" />Before this: {prereqs.map((p, i) => <>{i > 0 && ', '}<a href={url(p.href)}>{p.id} {p.title}</a></>)}</span>
    )}
  </div>
)}
{lesson && data.outcomes && data.outcomes.length > 0 && (
  <div class="lf-outcomes not-content">
    <p>You’ll be able to</p>
    <ul>{data.outcomes.map((o: string) => <li>{o}</li>)}</ul>
  </div>
)}
